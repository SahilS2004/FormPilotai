# Copy to apps/web/.env.local for local development.
# Production reads these from AWS Secrets Manager. Do not commit the real key.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

DATABASE_URL=postgresql://formpilot:formpilot_secure_pass_2026@127.0.0.1:5432/formpilot_db
S3_ENDPOINT=http://127.0.0.1:4566
S3_BUCKET=formpilot-kb
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
